import { useState, useEffect } from 'react';
import { v4 as uuidv4 } from 'uuid';

export type TaskType = 'delivery' | 'watch' | 'assignment';

export type Course = {
  id: string;
  name: string;
  description: string;
};

export type Task = {
  id: string;
  courseId: string;
  lectureName: string;
  type: TaskType;
  date: string; // ISO date string (YYYY-MM-DD or full)
  isSelfDeadline: boolean;
  completed: boolean;
};

type AppState = {
  courses: Course[];
  tasks: Task[];
};

const STORAGE_KEY = 'ondemand_app_data';

export const useAppStore = () => {
  const [courses, setCourses] = useState<Course[]>([]);
  const [tasks, setTasks] = useState<Task[]>([]);
  const [isLoaded, setIsLoaded] = useState(false);

  useEffect(() => {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const parsed = JSON.parse(saved) as AppState;
        setCourses(parsed.courses || []);
        // Migration payload for older tasks without lectureName
        const loadedTasks = (parsed.tasks || []).map(t => ({
          ...t,
          lectureName: t.lectureName || '無題の講義',
          isSelfDeadline: t.isSelfDeadline ?? (t as any).deadlineType === 'self'
        }));
        setTasks(loadedTasks);
      } catch (e) {
        console.error("Failed to parse storage", e);
      }
    }
    setIsLoaded(true);
  }, []);

  useEffect(() => {
    if (isLoaded) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ courses, tasks }));
    }
  }, [courses, tasks, isLoaded]);

  const addCourse = (name: string, description: string) => {
    const newCourse = { id: uuidv4(), name, description };
    setCourses([...courses, newCourse]);
    return newCourse.id;
  };

  const updateCourseDescription = (id: string, description: string) => {
    setCourses(courses.map(c => c.id === id ? { ...c, description } : c));
  };

  const deleteCourse = (id: string) => {
    setCourses(courses.filter(c => c.id !== id));
    setTasks(tasks.filter(t => t.courseId !== id));
  };

  const addTasks = (courseId: string, type: TaskType, dates: Date[], isSelfDeadline: boolean, lectureNames: string[]) => {
    const newTasks = dates.map((d, i) => ({
      id: uuidv4(),
      courseId,
      lectureName: lectureNames[i] || '無題の講義',
      type,
      date: d.toISOString(),
      isSelfDeadline,
      completed: false
    }));
    setTasks([...tasks, ...newTasks]);
  };

  const toggleTaskCompletion = (id: string) => {
    setTasks(tasks.map(t => t.id === id ? { ...t, completed: !t.completed } : t));
  };

  const addBatchTasks = (newTasksData: Omit<Task, 'id' | 'completed'>[]) => {
    const newTasks = newTasksData.map(t => ({
      ...t,
      id: uuidv4(),
      completed: false
    }));
    setTasks([...tasks, ...newTasks]);
  };

  const deleteTask = (id: string) => {
    setTasks(tasks.filter(t => t.id !== id));
  };

  const exportData = () => {
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({ courses, tasks }));
    const downloadAnchorNode = document.createElement('a');
    downloadAnchorNode.setAttribute("href", dataStr);
    downloadAnchorNode.setAttribute("download", "ondemand_backup.json");
    document.body.appendChild(downloadAnchorNode);
    downloadAnchorNode.click();
    downloadAnchorNode.remove();
  };

  const importData = (dataStr: string) => {
    try {
      const parsed = JSON.parse(dataStr) as AppState;
      if (parsed.courses && parsed.tasks) {
        setCourses(parsed.courses);
        setTasks(parsed.tasks);
        alert("データのインポートに成功しました");
      } else {
        alert("無効なデータ形式です");
      }
    } catch {
      alert("データの読み込みに失敗しました");
    }
  };

  return {
    courses,
    tasks,
    isLoaded,
    addCourse,
    updateCourseDescription,
    deleteCourse,
    addTasks,
    addBatchTasks,
    toggleTaskCompletion,
    deleteTask,
    exportData,
    importData
  };
};
